# ─── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://efutv.eu

# ─── Stripe ────────────────────────────────────────────────────
# RESTRICTED key (rk_live_... or rk_test_...) for server-side API calls.
# Create at: https://dashboard.stripe.com/apikeys → "Create restricted key"
# Required permissions: Charges:Write, Checkout Sessions:Write, Customers:Write, Subscriptions:Read
# STRIPE_SECRET_KEY=rk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# PUBLISHABLE key (pk_live_... or pk_test_...) for client-side (Stripe.js, Elements)
# Safe to expose in the browser — prefixed with NEXT_PUBLIC_ so Next.js includes it
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Product Price ID (price_xxx) for the season pass — leave empty to use inline pricing
# STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signing secret (whsec_...)  → https://dashboard.stripe.com/webhooks
# For local testing: stripe listen --forward-to localhost:3016/api/webhooks/stripe
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Cloudflare Stream ─────────────────────────────────────────
CF_ACCOUNT_ID=your-cloudflare-account-id-here
CF_STREAM_ID=your-cloudflare-stream-id-here                     # Live Input or Video ID
CF_STREAM_KEY_ID=your-cloudflare-stream-key-id-here             # Signing key ID from CF dashboard
CF_STREAM_PRIVATE_KEY=your-cloudflare-stream-private-key-here   # RSA private key for JWT signing (PEM, base64)

# ─── Database (pick one) ───────────────────────────────────────
DATABASE_URL=your-database-connection-string-here

# ─── Supabase (if using Supabase Auth) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ─── Google Analytics 4 ────────────────────────────────────────
# Public measurement id (G-XXXXXXXXXX) — exposed to the browser via
# the gtag.js loader. Safe to expose.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-3XQJLCY6YF

# The three below are read by the server-side Data API client
# (lib/analytics/ga-client.ts). They are NOT exposed to the client.
# For local dev, copy .dev.vars.example → .dev.vars and fill them in.
# For production, set via:
#   echo -n "..." | npx wrangler secret put GA_PROPERTY_ID
#   echo -n "..." | npx wrangler secret put GA_CLIENT_EMAIL
#   echo -n "..." | npx wrangler secret put GA_PRIVATE_KEY
# GA_PROPERTY_ID=123456789
# GA_CLIENT_EMAIL=ga-reader@project.iam.gserviceaccount.com
# GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── PostHog ──────────────────────────────────────────────────
# Public project token (phc_...) and EU ingest host. Both are NEXT_PUBLIC_
# so they're inlined into the client bundle at build time and used by
# instrumentation-client.ts to call posthog.init(...).
#
# Project token comes from PostHog → Project → Settings → Project → API keys.
# Host should match the region of your project (us.i.posthog.com / eu.i.posthog.com).
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
